---
import "../styles/styles.css";
---

<div id="sidebar">
    <h1 style="margin-top: 0">liquiprism 2.0</h1>
    <div>
        <button id="togglePlay" class="play-button">play</button>
    </div>

    <label for="dimension">dimension:</label>
    <div class="slider-container">
        <span id="minValue">1</span>
        <input
            type="range"
            id="dimension"
            name="dimension"
            min="1"
            max="21"
            value="7"
            oninput="updateDimensionSliderValue(this)"
        />
        <span id="maxValue">21</span>
    </div>

    <label for="speed">speed:</label>
    <div class="slider-container">
        <span id="minValue">0.5x</span>
        <input
            type="range"
            id="speed"
            name="speed"
            min="0.5"
            max="2"
            value="1"
            step="0.25"
            oninput="updateSpeedSliderValue(this)"
        />
        <span id="maxValue">2x</span>
    </div>

    <div class="form-group">
        <label for="randomUpdateRate">random update rate:</label>
        <input
            type="checkbox"
            id="randomUpdateRate"
            name="randomUpdateRate"
            onchange="updateRandomUpdateRate(this)"
        />
    </div>

    <div id="legend">
        <table class="legend-table">
            <tr class="legend-item legend-header">
                <th>c</th>
                <th>r</th>
                <th>i</th>
                <th>m</th>
            </tr>
            <tr class="legend-item" id="legend-front">
                <td class="color-box"></td>
                <td class="update-rate">
                    <select onchange="setFaceUpdateRate('front', this.value)">
                        <option value="1">1</option>
                        <option value="2" selected>2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                    </select>
                </td>
                <td class="instrument">
                    <select onchange="setFaceInstrument('front', this.value)">
                        <option value="flute" selected>flute</option>
                        <option value="lead">lead</option>
                    </select>
                </td>
                <td>
                    <input
                        type="checkbox"
                        id="muteFace"
                        name="muteFace"
                        onchange="setMuteFace(this)"
                    />
                </td>
            </tr>
            <tr class="legend-item" id="legend-back">
                <td class="color-box"></td>
                <td class="update-rate">
                    <select onchange="setFaceUpdateRate('back', this.value)">
                        <option value="1" selected>1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                    </select>
                </td>
                <td class="instrument"></td>
                <td>
                    <input
                        type="checkbox"
                        id="muteFace"
                        name="muteFace"
                        onchange="setMuteFace(this)"
                    />
                </td>
            </tr>
            <tr class="legend-item" id="legend-left">
                <td class="color-box"></td>
                <td class="update-rate">
                    <select onchange="setFaceUpdateRate('left', this.value)">
                        <option value="1" selected>1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                    </select>
                </td>
                <td class="instrument"></td>
                <td>
                    <input
                        type="checkbox"
                        id="muteFace"
                        name="muteFace"
                        onchange="setMuteFace(this)"
                    />
                </td>
            </tr>
            <tr class="legend-item" id="legend-right">
                <td class="color-box"></td>
                <td class="update-rate">
                    <select onchange="setFaceUpdateRate('right', this.value)">
                        <option value="1" selected>1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                    </select>
                </td>
                <td class="instrument"></td>
                <td>
                    <input
                        type="checkbox"
                        id="muteFace"
                        name="muteFace"
                        onchange="setMuteFace(this)"
                    />
                </td>
            </tr>
            <tr class="legend-item" id="legend-top">
                <td class="color-box"></td>
                <td class="update-rate">
                    <select onchange="setFaceUpdateRate('top', this.value)">
                        <option value="1" selected>1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                    </select>
                </td>
                <td class="instrument"></td>
                <td>
                    <input
                        type="checkbox"
                        id="muteFace"
                        name="muteFace"
                        onchange="setMuteFace(this)"
                    />
                </td>
            </tr>
            <tr class="legend-item" id="legend-bottom">
                <td class="color-box"></td>
                <td class="update-rate">
                    <select onchange="setFaceUpdateRate('bottom', this.value)">
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4" selected>4</option>
                    </select>
                </td>
                <td class="instrument"></td>
                <td>
                    <input
                        type="checkbox"
                        id="muteFace"
                        name="muteFace"
                        onchange="setMuteFace(this)"
                    />
                </td>
            </tr>
        </table>
    </div>
    <label for="volume" style="margin-top: 8px">volume:</label>
    <div class="slider-container">
        <span>0</span>
        <input
            type="range"
            id="volume"
            name="volume"
            min="0"
            max="1"
            value="0.1"
            step="0.01"
            oninput="updateVolume(this)"
        />
        <span>1</span>
    </div>
    <label for="reverb" style="margin-top: 8px">reverb:</label>
    <div class="slider-container">
        <span>dry</span>
        <input
            type="range"
            id="reverb"
            name="reverb"
            min="0"
            max="1"
            value="0.3"
            step="0.05"
            oninput="updateReverb(this)"
        />
        <span>wet</span>
    </div>
    <div class="explainer">
        <p>c: color</p>
        <p>r: update rate</p>
        <p>i: instrument</p>
        <p style="margin-bottom: 0">m: mute</p>
    </div>
</div>

<script is:inline>
    let playing = false;

    function togglePlay() {
        playing = !playing;
        const button = document.getElementById("togglePlay");
        button.textContent = playing ? "pause" : "play";
        button.classList.toggle("playing");
        const event = new CustomEvent("togglePlay", {
            detail: { playing },
        });
        document.dispatchEvent(event);
    }

    document.getElementById("togglePlay").addEventListener("click", togglePlay);

    document.addEventListener("keydown", (e) => {
        if (e.code === "Space") {
            e.preventDefault();
            togglePlay();
        }
    });

    function updateDimensionSliderValue(slider) {
        slider.setAttribute("data-value", slider.value);
        const event = new CustomEvent("dimensionChange", {
            detail: { dimension: slider.value },
        });
        document.dispatchEvent(event);
    }

    function updateSpeedSliderValue(slider) {
        slider.setAttribute("data-value", slider.value);
        const event = new CustomEvent("speed", {
            detail: { speed: slider.value },
        });
        document.dispatchEvent(event);
    }

    function updateRandomUpdateRate(checkbox) {
        const event = new CustomEvent("randomUpdateRateChange", {
            detail: { randomUpdateRate: checkbox.checked },
        });
        document.dispatchEvent(event);
    }

    function updateVolume(slider) {
        const event = new CustomEvent("volumeChange", {
            detail: { amount: parseFloat(slider.value) },
        });
        document.dispatchEvent(event);
    }

    function updateReverb(slider) {
        const event = new CustomEvent("reverbChange", {
            detail: { amount: parseFloat(slider.value) },
        });
        document.dispatchEvent(event);
    }

    function setMuteFace(checkbox) {
        const facePosition = checkbox.parentElement.parentElement.id
            .split("-")[1]
            .toUpperCase();
        const event = new CustomEvent("setMuteFace", {
            detail: { facePosition, muted: checkbox.checked },
        });
        document.dispatchEvent(event);
    }

    function setFaceUpdateRate(facePosition, updateRate) {
        const event = new CustomEvent("faceUpdateRateChange", {
            detail: {
                facePosition: facePosition.toUpperCase(),
                updateRate: parseInt(updateRate),
            },
        });
        document.dispatchEvent(event);
    }

    function setFaceInstrument(facePosition, instrument) {
        const event = new CustomEvent("faceInstrumentChange", {
            detail: {
                facePosition: facePosition.toUpperCase(),
                instrument: instrument,
            },
        });
        document.dispatchEvent(event);
    }

    document.addEventListener("DOMContentLoaded", () => {
        const dimension_slider = document.getElementById("dimension");
        if (dimension_slider instanceof HTMLInputElement) {
            updateDimensionSliderValue(dimension_slider);
        }

        const speed_slider = document.getElementById("speed");
        if (speed_slider instanceof HTMLInputElement) {
            updateSpeedSliderValue(speed_slider);
        }

        const reverb_slider = document.getElementById("reverb");
        if (reverb_slider instanceof HTMLInputElement) {
            updateReverb(reverb_slider);
        }

        const volume_slider = document.getElementById("volume");
        if (volume_slider instanceof HTMLInputElement) {
            updateVolume(volume_slider);
        }
    });

    document.addEventListener("updateLegendVisualizer", (event) => {
        const legendData = event.detail.legendData;
        legendData.forEach((face) => {
            const legendItem = document.getElementById(
                `legend-${face.position.toLowerCase()}`,
            );
            if (legendItem) {
                legendItem.querySelector(".color-box").style.backgroundColor =
                    face.color;
                const dropdown = legendItem.querySelector(
                    ".update-rate select",
                );
                if (dropdown) {
                    dropdown.value = face.updateRate.toString();
                }
            }
        });
    });

    document.addEventListener("updateLegendSonifier", (event) => {
        const legendData = event.detail.legendData;
        legendData.forEach((data) => {
            const legendItem = document.getElementById(
                `legend-${data.position}`,
            );
            if (legendItem) {
                const instrumentCell = legendItem.querySelector(".instrument");
                if (data.position === "front") {
                    const dropdown = instrumentCell.querySelector("select");
                    if (dropdown) {
                        dropdown.value = data.instrument;
                    }
                } else {
                    instrumentCell.textContent = `${data.instrument}`;
                }
            } else {
                console.log("no legend item found");
            }
        });
    });
</script>
